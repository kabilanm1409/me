# Environment Variables Template
# Copy this file to .env and set your real credentials locally.

PORTFOLIO_ADMIN_USER=your_admin_username
PORTFOLIO_ADMIN_PASS=your_admin_password

FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

FORMSPREE_ENDPOINT=your_formspree_endpoint_url
